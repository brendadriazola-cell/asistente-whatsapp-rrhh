      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"accion\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"responder\",\n        \"calificar\",\n        \"derivar\"\n      ]\n    },\n    \"temperatura\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"caliente\",\n        \"tibio\",\n        \"frio\",\n        \"sin_dato\"\n      ]\n    },\n    \"respuesta\": {\n      \"type\": \"string\",\n      \"description\": \"Texto que se envía por WhatsApp\"\n    },\n    \"empresa\": {\n      \"type\": \"string\"\n    },\n    \"perfil_buscado\": {\n      \"type\": \"string\"\n    },\n    \"cantidad_posiciones\": {\n      \"type\": \"string\"\n    },\n    \"urgencia\": {\n      \"type\": \"string\"\n    },\n    \"resumen\": {\n      \"type\": \"string\",\n      \"description\": \"Una línea para el equipo comercial\"\n    }\n  },\n  \"required\": [\n    \"accion\",\n    \"temperatura\",\n    \"respuesta\",\n    \"empresa\",\n    \"perfil_buscado\",\n    \"cantidad_posiciones\",\n    \"urgencia\",\n    \"resumen\"\n  ]\n}"
      },
      "id": "16e56d25-dec3-4431-9875-914c1194b888",
      "name": "Formato de salida",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1240,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Valida la salida del AI Agent ANTES de responder o escribir en la planilla.\n// Si el agente falló o devolvió algo incompleto, se usa una respuesta de respaldo\n// y el caso se deriva a una persona: el contacto nunca se queda sin respuesta.\nconst agente = $input.first().json;\nconst datos = $('Datos del mensaje').first().json;\nconst out = agente.output || {};\n\nconst ACCIONES = ['responder', 'calificar', 'derivar'];\nconst TEMPERATURAS = ['caliente', 'tibio', 'frio', 'sin_dato'];\n\n// Problemas graves: no se puede usar lo que dijo el agente\nconst graves = [];\nif (agente.error) graves.push('Error del agente: ' + (agente.error.message || agente.error));\nif (!ACCIONES.includes(out.accion)) graves.push('Acción inválida: ' + out.accion);\nif (typeof out.respuesta !== 'string' || out.respuesta.trim() === '') graves.push('Respuesta vacía');\nconst valido = graves.length === 0;\n\n// Problema leve: quiso registrar el lead sin los datos mínimos -> solo responde\nlet accion = valido ? out.accion : 'derivar';\nconst avisos = [...graves];\nif (accion === 'calificar' && (!out.empresa || !out.perfil_buscado)) {\n  accion = 'responder';\n  avisos.push('Calificó sin empresa o sin perfil: se cambió a responder');\n}\n\nconst RESPALDO = datos.en_horario\n  ? '¡Gracias por escribirnos! En un rato te contacta una persona del equipo para ayudarte.'\n  : '¡Gracias por escribirnos! Nuestro horario es de lunes a viernes de 9 a 18 h. El próximo día hábil te contacta una persona del equipo.';\n\nreturn [{ json: {\n  ...datos,\n  valido,\n  error_agente: avisos.join(' | '),\n  accion,\n  temperatura: TEMPERATURAS.includes(out.temperatura) ? out.temperatura : 'sin_dato',\n  respuesta: valido ? out.respuesta.trim().slice(0, 1000) : RESPALDO,\n  empresa: out.empresa || '',\n  perfil_buscado: out.perfil_buscado || '',\n  cantidad_posiciones: String(out.cantidad_posiciones ?? ''),\n  urgencia: out.urgencia || '',\n  resumen: out.resumen || 'Derivado por falla del agente: revisar la conversación',\n} }];"
      },
